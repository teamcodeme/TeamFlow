# TeamFlow environment example. Copy to .env and replace development-only values.
TEAMFLOW_ENV=development
TEAMFLOW_HTTP_HOST=127.0.0.1
TEAMFLOW_API_PORT=8080
TEAMFLOW_WEB_PORT=4200
TEAMFLOW_DOCS_PORT=4173
TEAMFLOW_PUBLIC_API_URL=http://localhost:8080/api/v1

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=teamflow
DATABASE_USER=teamflow
DATABASE_PASSWORD=change-me
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNECTIONS=20
DATABASE_MAX_IDLE_CONNECTIONS=5

AUTH_MODE=builtin
JWT_ISSUER=teamflow-local
JWT_AUDIENCE=teamflow-web
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_HOURS=24
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

STORAGE_DRIVER=filesystem
STORAGE_LOCAL_PATH=.local/storage
STORAGE_MAX_UPLOAD_MB=20
STORAGE_ALLOWED_TYPES=application/pdf,image/png,image/jpeg,text/plain

LOG_LEVEL=debug
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4173

ROADMAP_DATA_PATH=packages/roadmap-data/roadmap.json
